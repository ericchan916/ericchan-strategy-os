# Real report LLM（用于 npm run report 的策略分析）
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Ask Mode 动态问答 LLM（用于 npm run ask / npm run ask:ui）
# 默认关闭。开启后 Ask Mode 会调用 LLM 生成动态中文战略回答；
# 调用失败时会自动回退到本地规则回答，并提示中文 warning。
STRATEGY_OS_LLM_ENABLED=false
STRATEGY_OS_LLM_BASE_URL=https://api.openai.com/v1
STRATEGY_OS_LLM_API_KEY=
STRATEGY_OS_LLM_MODEL=
STRATEGY_OS_LLM_TIMEOUT_MS=30000

# Ask Mode 按需联网搜索（默认关闭；只在 UI 勾选或 CLI --search 时使用）
STRATEGY_OS_SEARCH_ENABLED=false
# Provider 可选：tavily 或 bocha
STRATEGY_OS_SEARCH_PROVIDER=
STRATEGY_OS_SEARCH_API_KEY=
STRATEGY_OS_SEARCH_BASE_URL=
STRATEGY_OS_SEARCH_TIMEOUT_MS=15000
STRATEGY_OS_SEARCH_MAX_RESULTS=5

# Bocha 示例：
# STRATEGY_OS_SEARCH_PROVIDER=bocha
# STRATEGY_OS_SEARCH_BASE_URL=https://api.bochaai.com/v1/web-search
